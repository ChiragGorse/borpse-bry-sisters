{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "sim:soak": "node scripts/run-ts.mjs scripts/sim-soak.ts",
    "server": "node scripts/run-ts.mjs server/index.ts",
    "server:build": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist-server/server.mjs",
    "start": "node dist-server/server.mjs",
    "net:test": "node scripts/run-ts.mjs scripts/net-test.ts",
    "allen:test": "node scripts/run-ts.mjs scripts/allen-test.ts",
    "finale:test": "node scripts/run-ts.mjs scripts/finale-test.ts",
    "hunt:test": "node scripts/run-ts.mjs scripts/hunt-test.ts",
    "respawn:test": "node scripts/run-ts.mjs scripts/respawn-test.ts",
    "stun:test": "node scripts/run-ts.mjs scripts/stun-test.ts"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "5.1.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-plugin-singlefile": "2.3.0"
  }
}
